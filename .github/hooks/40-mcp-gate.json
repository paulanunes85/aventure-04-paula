{
    "version": 1,
    "disableAllHooks": false,
    "hooks": {
        "permissionRequest": [
            {
                "type": "command",
                "bash": "python3 .github/hooks/scripts/fleet_gate.py permission-request",
                "powershell": "python .github/hooks/scripts/fleet_gate.py permission-request",
                "cwd": ".",
                "timeoutSec": 10
            }
        ],
        "preMcpToolCall": [
            {
                "type": "command",
                "bash": "python3 .github/hooks/scripts/fleet_gate.py mcp-tool-call",
                "powershell": "python .github/hooks/scripts/fleet_gate.py mcp-tool-call",
                "cwd": ".",
                "timeoutSec": 10
            }
        ]
    }
}

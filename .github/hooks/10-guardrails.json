{
    "version": 1,
    "disableAllHooks": false,
    "hooks": {
        "preToolUse": [
            {
                "type": "command",
                "bash": "python3 .github/hooks/scripts/fleet_gate.py pre-tool-use",
                "powershell": "python .github/hooks/scripts/fleet_gate.py pre-tool-use",
                "cwd": ".",
                "timeoutSec": 10
            }
        ],
        "postToolUse": [
            {
                "type": "command",
                "bash": "python3 .github/hooks/scripts/fleet_gate.py post-tool-use",
                "powershell": "python .github/hooks/scripts/fleet_gate.py post-tool-use",
                "cwd": ".",
                "timeoutSec": 10
            }
        ],
        "postToolUseFailure": [
            {
                "type": "command",
                "bash": "python3 .github/hooks/scripts/fleet_gate.py post-tool-use-failure",
                "powershell": "python .github/hooks/scripts/fleet_gate.py post-tool-use-failure",
                "cwd": ".",
                "timeoutSec": 10
            }
        ]
    }
}
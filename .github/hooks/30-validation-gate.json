{
    "version": 1,
    "disableAllHooks": false,
    "hooks": {
        "subagentStop": [
            {
                "type": "command",
                "bash": "python3 .github/hooks/scripts/fleet_gate.py subagent-stop",
                "powershell": "python .github/hooks/scripts/fleet_gate.py subagent-stop",
                "cwd": ".",
                "timeoutSec": 900
            }
        ],
        "agentStop": [
            {
                "type": "command",
                "bash": "python3 .github/hooks/scripts/fleet_gate.py agent-stop",
                "powershell": "python .github/hooks/scripts/fleet_gate.py agent-stop",
                "cwd": ".",
                "timeoutSec": 10
            }
        ],
        "sessionEnd": [
            {
                "type": "command",
                "bash": "python3 .github/hooks/scripts/fleet_gate.py session-end",
                "powershell": "python .github/hooks/scripts/fleet_gate.py session-end",
                "cwd": ".",
                "timeoutSec": 10
            }
        ]
    }
}
{
    "version": 1,
    "disableAllHooks": false,
    "hooks": {
        "sessionStart": [
            {
                "type": "command",
                "bash": "python3 .github/hooks/scripts/fleet_gate.py session-start",
                "powershell": "python .github/hooks/scripts/fleet_gate.py session-start",
                "cwd": ".",
                "timeoutSec": 10
            }
        ],
        "subagentStart": [
            {
                "type": "command",
                "bash": "python3 .github/hooks/scripts/fleet_gate.py subagent-start",
                "powershell": "python .github/hooks/scripts/fleet_gate.py subagent-start",
                "cwd": ".",
                "timeoutSec": 10
            }
        ]
    }
}